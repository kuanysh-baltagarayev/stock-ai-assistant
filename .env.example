APP_NAME=Stock AI Assistant
DATABASE_URL=sqlite:///./stock_ai_assistant.db
APP_HOST=127.0.0.1
APP_PORT=8000
ALLOW_REMOTE_API=0

# Optional. The app works without this key and falls back to rule-based explanations.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Market data resilience
MARKET_DATA_TIMEOUT_SECONDS=20
MARKET_DATA_MAX_ATTEMPTS=3
MARKET_DATA_RETRY_BACKOFF_SECONDS=1.5

# Telegram bot settings
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_TICKERS=AAPL,MSFT,NVDA,TSLA,AMD,AMZN,GOOGL,META
TELEGRAM_DIGEST_INTERVAL_MINUTES=1440
TELEGRAM_POLL_TIMEOUT_SECONDS=30

# Opt-in flag for live network checks and smoke scripts.
ALLOW_LIVE_NETWORK=0
