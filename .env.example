APP_NAME=Stock AI Assistant
DATABASE_URL=sqlite:///./stock_ai_assistant.db
APP_HOST=127.0.0.1
APP_PORT=8000
# Keep 0 during MVP — the API stays bound to localhost only
ALLOW_REMOTE_API=0

# LLM provider for analysis explanations: anthropic (default) | openai | deepseek.
# The app works without an LLM key and falls back to rule-based explanations.
LLM_PROVIDER=anthropic

# Anthropic API (default provider). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# claude-haiku-4-5 (default — fast & low cost). Use claude-opus-4-8 for max quality.
ANTHROPIC_MODEL=claude-haiku-4-5

# OpenAI / DeepSeek (used only when LLM_PROVIDER is openai or deepseek).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Market data resilience
# Optional fallback source for daily prices when yfinance fails (format change,
# IP ban, empty response). Get a free key at https://www.alphavantage.co/support/#api-key
# Without it the app still runs on yfinance alone; with it, scans survive yfinance outages.
ALPHA_VANTAGE_API_KEY=
# Optional primary source for the real-time current price (free /quote endpoint,
# 60 req/min). Get a free key at https://finnhub.io/register
# Without it, price falls back to yfinance/history. Technicals always use history.
FINNHUB_API_KEY=
MARKET_DATA_TIMEOUT_SECONDS=20
MARKET_DATA_MAX_ATTEMPTS=3
MARKET_DATA_RETRY_BACKOFF_SECONDS=1.5
MARKET_DATA_CACHE_TTL_SECONDS=3600

# Runtime budgets
PROVIDER_CALL_BUDGET=1000
LLM_CALL_BUDGET=50
TELEGRAM_SEND_BUDGET=200
ANALYSIS_SNAPSHOT_RETENTION_COUNT=50
ANALYSIS_SNAPSHOT_RETENTION_DAYS=365

# Telegram bot settings
TELEGRAM_ENABLED=1
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# Comma-separated list of Telegram user/chat IDs allowed to use the bot
# Find your ID: send /start to @userinfobot
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_DEFAULT_TICKERS=AAPL,MSFT,NVDA,TSLA,AMD,AMZN,GOOGL,META
TELEGRAM_DIGEST_INTERVAL_MINUTES=1440
TELEGRAM_POLL_TIMEOUT_SECONDS=30

# Market regime context (experimental, disabled by default)
# Enables SPY/QQQ trend, VIX, 10Y yield, and sector rotation analysis
# Requires yfinance data; adds ~4 yfinance calls per scan
MARKET_REGIME_ENABLED=0

# Opt-in flag for live network checks and smoke scripts.
ALLOW_LIVE_NETWORK=0
